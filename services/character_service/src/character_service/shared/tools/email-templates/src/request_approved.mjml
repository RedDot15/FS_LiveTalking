<mjml>
  <mj-head>
    <mj-title>Request Approved</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-size="16px" color="#333333" line-height="24px"></mj-text>
      <mj-section padding="20px 0"></mj-section>
    </mj-attributes>
    <mj-style>
      .detail-label { font-weight: bold; color: #777777; }
      .detail-value { color: #333333; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f4">

    <mj-section background-color="#ffffff" padding-bottom="0px">
      <mj-column width="100%">
        <mj-text align="center" font-size="24px" font-weight="bold" color="#4A90E2">
          {{ project_name }}
        </mj-text>
        <mj-divider border-color="#4A90E2" border-width="2px"></mj-divider>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff">
      <mj-column width="100%">
        <mj-text font-size="20px" font-weight="bold">
          Great news! Your request has been approved.
        </mj-text>
        <mj-text>
          Hello {{ created_by }}, your request for the character <strong>{{ character_name }}</strong> has been reviewed and successfully approved.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#fafafa" border="1px solid #eeeeee">
      <mj-column width="100%">
        <mj-table>
          <tr style="text-align:left;padding:15px 0;">
            <th style="padding: 0 15px 0 0;">Character ID</th>
            <td style="padding: 0 15px;">{{ character_id }}</td>
          </tr>
          <tr style="text-align:left;padding:15px 0;">
            <th style="padding: 0 15px 0 0;">Created At</th>
            <td style="padding: 0 15px;">{{ created_at }}</td>
          </tr>
          <tr style="text-align:left;padding:15px 0;">
            <th style="padding: 0 15px 0 0;">Approved By</th>
            <td style="padding: 0 15px;">{{ approved_by }}</td>
          </tr>
          <tr style="text-align:left;padding:15px 0;">
            <th style="padding: 0 15px 0 0;">Approved At</th>
            <td style="padding: 0 15px;">{{ approved_at }}</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff">
      <mj-column width="100%">
        <mj-button background-color="#4A90E2" color="white" href="{{ character_url }}" font-size="18px" border-radius="4px">
          View Character
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column width="100%">
        <mj-text align="center" font-size="12px" color="#aaaaaa">
          This is an automated message from {{ project_name }}.<br/>
          If you have any questions, please contact our support team.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>